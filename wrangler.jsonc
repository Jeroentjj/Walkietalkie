{
  "name": "walkietalkie",
  "main": "src/api.js",
  "compatibility_date": "2025-09-01",
  "routes": [{ "pattern": "walkie.dopimo.app", "custom_domain": true }],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": { "bindings": [{ "name": "CHANNEL", "class_name": "Channel" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Channel"] }],
  // Auto-provisioned on first deploy.
  "kv_namespaces": [{ "binding": "WALKIE", "id": "6b99de7982ee4ca3a67736b53f331399" }]
}
