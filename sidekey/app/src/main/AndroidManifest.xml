<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- To list the apps for the smart action, and to ask WLKY whether it is on screen. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <provider android:authorities="app.wlky.state" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="${icon}"
        android:roundIcon="${icon}"
        android:theme="@style/Theme.Settings">
        <!-- The only launcher entry: the side key starts it and it runs this app's action; tapping the icon in the launcher opens the settings. -->
        <activity
            android:name=".ActionActivity"
            android:theme="@style/Theme.Action"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".TorchAct" android:theme="@style/Theme.Action" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="" />
        <activity android:name=".SoundAct" android:theme="@style/Theme.Action" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="" />
        <activity android:name=".CameraAct" android:theme="@style/Theme.Action" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="" />
        <activity android:name=".LocationAct" android:theme="@style/Theme.Action" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="" />
        <activity android:name=".CallAct" android:theme="@style/Theme.Action" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="" />
        <activity android:name=".AssistAct" android:theme="@style/Theme.Action" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="" />
        <activity android:name=".SmartAct" android:theme="@style/Theme.Action" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="" />
    </application>
</manifest>
